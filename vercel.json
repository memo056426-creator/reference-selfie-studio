{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:endpoint*",
      "destination": "/api/index?endpoint=:endpoint*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
